      "theme": "astra-legal-theme",
      "language": "astra-legal-language",
      "userPreferences": "astra-legal-preferences",
      "id": "astra-legal-id",
      "sessionId": "astra-legal-session-id",
      "allowAnalytics": "astra-legal-allow-analytics",
      "analyticsConsentSnooze": "astra-legal-allow-analytics-snooze",
      "pageViewCount": "astra-legal-page-view-count"
    },
    "features": {
      "debugMode": false
    },
    "navigation": {
      "scrollRestoration": {
        "mode": "top",
        "behavior": "smooth"
      }
    },
    "analytics": {
      "enabled": false,
      "consentUI": "none",
      "consentSnoozeSeconds": 30,
      "track": [
        "language",
        "platform",
        "screenWidth",
        "screenHeight",
        "timezone"
      ],

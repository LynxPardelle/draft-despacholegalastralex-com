          "event": "page_view",
          "path": "metrics.pageViews",
          "by": 1
        },
        "events": [
          {
            "name": "cta_click",
            "path": "metrics.ctaClicks",
            "by": 1
          },
          {
            "name": "nav_click",
            "path": "metrics.navClicks",
            "by": 1
          }
        ]
      }
    }

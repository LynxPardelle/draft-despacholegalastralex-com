{
  "version": 1,
  "domain": "grupoastralegal.com",
  "pageId": "not-found",
  "components": [
    {
      "id": "notFoundPage",
      "type": "container",
      "config": {
        "id": "main-content",
        "tag": "main",
        "tabindex": -1,
        "classes": "sectionBase ank-minHeight-70vh",
        "components": [
          "notFoundPanel"
        ]
      }
    },
    {
      "id": "notFoundPanel",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "sectionContent panel ank-alignItems-start",
        "components": [
          "notFoundTitle",
          "notFoundDescription",
          "notFoundActions"
        ]
      }
    },
    {
      "id": "notFoundTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.title",
      "config": {
        "tag": "h1",
        "text": "",
        "classes": "sectionTitle"
      }
    },
    {
      "id": "notFoundDescription",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.description",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "sectionSubtitle"
      }
    },
    {
      "id": "notFoundActions",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-gap-12px ank-flexWrap-wrap",
        "components": [
          "notFoundHome",
          "notFoundServices"
        ]
      }
    },
    {
      "id": "notFoundHome",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,page.primaryLabel",
      "config": {
        "href": "/",
        "text": "",
        "classes": "primaryAction ank-color-bgColor"
      }
    },
    {
      "id": "notFoundServices",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,page.secondaryLabel",
      "config": {
        "href": "/servicios",
        "text": "",
        "classes": "secondaryAction"
      }
    }
  ]
}

{
  "version": 1,
  "domain": "grupoastralegal.com",
  "pageId": "recuperacion-impuestos-inmobiliarios",
  "components": [
    {
      "id": "contentPage",
      "type": "container",
      "config": {
        "id": "main-content",
        "tag": "main",
        "tabindex": -1,
        "classes": "ank-width-100per ank-overflowX-hidden",
        "components": [
          "detailHero",
          "calculatorSection",
          "detailBody",
          "detailCta"
        ]
      }
    },
    {
      "id": "detailHero",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "sectionBase",
        "components": ["detailHeroContent"]
      }
    },
    {
      "id": "detailHeroContent",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "sectionContent",
        "components": ["detailEyebrow", "detailTitle", "detailSummary"]
      }
    },
    {
      "id": "detailEyebrow",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.eyebrow",
      "config": { "tag": "p", "text": "", "classes": "sectionEyebrow" }
    },
    {
      "id": "detailTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.title",
      "config": { "tag": "h1", "text": "", "classes": "sectionTitle ank-maxWidth-22ch" }
    },
    {
      "id": "detailSummary",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.summary",
      "config": { "tag": "p", "text": "", "classes": "sectionSubtitle" }
    },
    {
      "id": "calculatorSection",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "calculatorSection",
        "components": ["calculatorScope"]
      }
    },
    {
      "id": "calculatorScope",
      "type": "interaction-scope",
      "config": {
        "scopeId": "isaiCalculator",
        "id": "isai-calculator",
        "tag": "form",
        "classes": "calculatorCard",
        "initialValues": {
          "cityRateCode": 8,
          "propertyValue": null,
          "purchaseYear": null,
          "hasCalculated": false
        },
        "computations": [
          {
            "resultId": "recoveryMin",
            "initial": { "source": "field", "fieldId": "cityRateCode" },
            "steps": [
              { "op": "abs" },
              { "op": "divide", "value": { "source": "literal", "value": 100 } },
              { "op": "multiply", "value": { "source": "field", "fieldId": "propertyValue" } },
              { "op": "round", "precision": 0 }
            ]
          },
          {
            "resultId": "recoveryMax",
            "initial": { "source": "field", "fieldId": "cityRateCode" },
            "steps": [
              { "op": "abs" },
              { "op": "divide", "value": { "source": "literal", "value": 5 } },
              { "op": "ceil" },
              { "op": "multiply", "value": { "source": "literal", "value": 0.04 } },
              { "op": "add", "value": { "source": "literal", "value": 0.01 } },
              { "op": "multiply", "value": { "source": "field", "fieldId": "propertyValue" } },
              { "op": "round", "precision": 0 }
            ]
          }
        ],
        "submitEventInstructions": "setScopeValue:hasCalculated,event.eventData.valid;focusElementById:propertyValue,event.eventData.fields.propertyValue.valid,false;focusElementById:purchaseYear-option-0,event.eventData.fields.propertyValue.valid,true,event.eventData.fields.purchaseYear.valid,false;focusElementById:isai-calculator-result,event.eventData.valid,true",
        "components": [
          "calculatorAccent",
          "calculatorHeader",
          "calculatorCity",
          "calculatorPropertyValue",
          "calculatorPurchaseYear",
          "calculatorSubmit",
          "calculatorResult"
        ]
      }
    },
    {
      "id": "calculatorAccent",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "calculatorAccent",
        "components": []
      }
    },
    {
      "id": "calculatorHeader",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-8px",
        "components": ["calculatorEyebrow", "calculatorTitle", "calculatorDescription"]
      }
    },
    {
      "id": "calculatorEyebrow",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.calculator.eyebrow",
      "config": { "tag": "p", "text": "", "classes": "sectionEyebrow" }
    },
    {
      "id": "calculatorTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.calculator.title",
      "config": { "tag": "h2", "text": "", "classes": "calculatorTitle" }
    },
    {
      "id": "calculatorDescription",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.calculator.description",
      "config": { "tag": "p", "text": "", "classes": "calculatorDescription" }
    },
    {
      "id": "calculatorCity",
      "type": "input",
      "eventInstructions": "setScopeValue:hasCalculated,false",
      "valueInstructions": "set:config.label,i18n,page.calculator.cityLabel",
      "config": {
        "fieldId": "cityRateCode",
        "controlType": "button-group",
        "label": "",
        "value": 8,
        "multiple": false,
        "required": true,
        "options": { "source": "i18n", "path": "page.calculator.cityOptions" },
        "classes": "calculatorQuestion",
        "labelClasses": "calculatorQuestionLabel",
        "optionContainerClasses": "calculatorChoices calculatorChoicesThree",
        "optionClasses": "calculatorChoice",
        "activeOptionClasses": "calculatorChoiceActive"
      }
    },
    {
      "id": "calculatorPropertyValue",
      "type": "input",
      "eventInstructions": "setScopeValue:hasCalculated,false",
      "valueInstructions": "set:config.label,i18n,page.calculator.propertyLabel;set:config.placeholder,i18n,page.calculator.propertyPlaceholder;set:config.validation,i18n,page.calculator.propertyValidation",
      "config": {
        "fieldId": "propertyValue",
        "controlType": "number",
        "label": "",
        "placeholder": "",
        "value": null,
        "min": 1000000,
        "step": 1,
        "required": true,
        "validation": [],
        "classes": "calculatorQuestion",
        "labelClasses": "calculatorQuestionLabel",
        "fieldClasses": "calculatorNumberInput",
        "inputClasses": "calculatorNumberInput",
        "errorClasses": "calculatorError"
      }
    },
    {
      "id": "calculatorPurchaseYear",
      "type": "input",
      "eventInstructions": "setScopeValue:hasCalculated,false",
      "valueInstructions": "set:config.label,i18n,page.calculator.yearLabel;set:config.validation,i18n,page.calculator.yearValidation",
      "config": {
        "fieldId": "purchaseYear",
        "controlType": "button-group",
        "label": "",
        "value": null,
        "multiple": false,
        "required": true,
        "validation": [],
        "options": { "source": "i18n", "path": "page.calculator.yearOptions" },
        "classes": "calculatorQuestion",
        "labelClasses": "calculatorQuestionLabel",
        "optionContainerClasses": "calculatorChoices calculatorChoicesFour",
        "optionClasses": "calculatorChoice",
        "activeOptionClasses": "calculatorChoiceActive",
        "errorClasses": "calculatorError"
      }
    },
    {
      "id": "calculatorSubmit",
      "type": "button",
      "valueInstructions": "set:config.label,i18n,page.calculator.action",
      "config": {
        "type": "submit",
        "label": "",
        "classes": "calculatorPrimaryAction"
      }
    },
    {
      "id": "calculatorResult",
      "type": "container",
      "condition": "all:scopeEq,meta.submitted,true;all:scopeEq,meta.valid,true;all:scopeEq,values.hasCalculated,true",
      "config": {
        "id": "isai-calculator-result",
        "tag": "div",
        "role": "status",
        "ariaLive": "polite",
        "tabindex": -1,
        "classes": "calculatorResult",
        "components": [
          "calculatorResultTitle",
          "calculatorRange",
          "calculatorInvestment",
          "calculatorDisclaimer",
          "calculatorResultActions"
        ]
      }
    },
    {
      "id": "calculatorResultTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.calculator.resultTitle",
      "config": { "tag": "h3", "text": "", "classes": "calculatorResultTitle" }
    },
    {
      "id": "calculatorRange",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "calculatorRange",
        "components": ["calculatorRangeMin", "calculatorRangeMax"]
      }
    },
    {
      "id": "calculatorRangeMin",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "calculatorAmount",
        "components": ["calculatorRangeMinLabel", "calculatorRangeMinValue"]
      }
    },
    {
      "id": "calculatorRangeMinLabel",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.calculator.resultMinLabel",
      "config": { "tag": "span", "text": "", "classes": "calculatorAmountLabel" }
    },
    {
      "id": "calculatorRangeMinValue",
      "type": "generic-cell",
      "valueInstructions": "set:config.value,scope,computed.recoveryMin",
      "config": {
        "value": null,
        "format": "currency",
        "currency": "MXN",
        "currencyDisplay": "narrowSymbol",
        "maximumFractionDigits": 0,
        "showCurrencyCode": true,
        "emptyText": "",
        "classes": "calculatorAmountValue"
      }
    },
    {
      "id": "calculatorRangeMax",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "calculatorAmount",
        "components": ["calculatorRangeMaxLabel", "calculatorRangeMaxValue"]
      }
    },
    {
      "id": "calculatorRangeMaxLabel",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.calculator.resultMaxLabel",
      "config": { "tag": "span", "text": "", "classes": "calculatorAmountLabel" }
    },
    {
      "id": "calculatorRangeMaxValue",
      "type": "generic-cell",
      "valueInstructions": "set:config.value,scope,computed.recoveryMax",
      "config": {
        "value": null,
        "format": "currency",
        "currency": "MXN",
        "currencyDisplay": "narrowSymbol",
        "maximumFractionDigits": 0,
        "showCurrencyCode": true,
        "emptyText": "",
        "classes": "calculatorAmountValue"
      }
    },
    {
      "id": "calculatorInvestment",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "calculatorInvestment",
        "components": [
          "calculatorInvestmentLabel",
          "calculatorInvestmentLowValue",
          "calculatorInvestmentMidLowValue",
          "calculatorInvestmentMidHighValue",
          "calculatorInvestmentHighValue"
        ]
      }
    },
    {
      "id": "calculatorInvestmentLabel",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.calculator.investmentLabel",
      "config": { "tag": "span", "text": "", "classes": "calculatorInvestmentLabel" }
    },
    {
      "id": "calculatorInvestmentLowValue",
      "type": "generic-cell",
      "condition": "all:scopeLt,computed.recoveryMin,185000",
      "config": {
        "value": 12500,
        "format": "currency",
        "currency": "MXN",
        "currencyDisplay": "narrowSymbol",
        "maximumFractionDigits": 0,
        "showCurrencyCode": true,
        "emptyText": "",
        "classes": "calculatorInvestmentValue"
      }
    },
    {
      "id": "calculatorInvestmentMidLowValue",
      "type": "generic-cell",
      "condition": "all:scopeGte,computed.recoveryMin,185000;all:scopeLt,computed.recoveryMin,200000",
      "config": {
        "value": 15000,
        "format": "currency",
        "currency": "MXN",
        "currencyDisplay": "narrowSymbol",
        "maximumFractionDigits": 0,
        "showCurrencyCode": true,
        "emptyText": "",
        "classes": "calculatorInvestmentValue"
      }
    },
    {
      "id": "calculatorInvestmentMidHighValue",
      "type": "generic-cell",
      "condition": "all:scopeGte,computed.recoveryMin,200000;all:scopeLt,computed.recoveryMin,250000",
      "config": {
        "value": 20000,
        "format": "currency",
        "currency": "MXN",
        "currencyDisplay": "narrowSymbol",
        "maximumFractionDigits": 0,
        "showCurrencyCode": true,
        "emptyText": "",
        "classes": "calculatorInvestmentValue"
      }
    },
    {
      "id": "calculatorInvestmentHighValue",
      "type": "generic-cell",
      "condition": "all:scopeGte,computed.recoveryMin,250000",
      "config": {
        "value": 25000,
        "format": "currency",
        "currency": "MXN",
        "currencyDisplay": "narrowSymbol",
        "maximumFractionDigits": 0,
        "showCurrencyCode": true,
        "emptyText": "",
        "classes": "calculatorInvestmentValue"
      }
    },
    {
      "id": "calculatorDisclaimer",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.calculator.disclaimer",
      "config": { "tag": "p", "text": "", "classes": "calculatorDisclaimer" }
    },
    {
      "id": "calculatorResultActions",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "calculatorResultActions",
        "components": ["calculatorContactLink", "calculatorReset"]
      }
    },
    {
      "id": "calculatorContactLink",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,page.calculator.resultCta;set:config.href,var,ctaTargets.whatsappUrl",
      "config": {
        "href": "#",
        "text": "",
        "target": "_blank",
        "rel": "noopener noreferrer",
        "classes": "calculatorPrimaryAction ank-color-bgColor"
      }
    },
    {
      "id": "calculatorReset",
      "type": "button",
      "eventInstructions": "resetScope;focusElementById:propertyValue",
      "valueInstructions": "set:config.label,i18n,page.calculator.reset",
      "config": {
        "type": "button",
        "label": "",
        "classes": "calculatorSecondaryAction"
      }
    },
    {
      "id": "detailBody",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "sectionBase ank-bg-secondaryBgColor ank-paddingBlock-36px ank-paddingBlock-md-64px",
        "components": ["detailBodyGrid"]
      }
    },
    {
      "id": "detailBodyGrid",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-width-100per ank-maxWidth-1180px ank-display-grid ank-gridTemplateColumns-1fr ank-gridTemplateColumns-md-0_95fr__1_05fr ank-gap-18px ank-alignItems-start",
        "components": ["detailIntroPanel", "detailCardsGrid"]
      }
    },
    {
      "id": "detailIntroPanel",
      "type": "container",
      "config": {
        "tag": "aside",
        "classes": "panel ank-display-flex ank-flexDirection-column ank-gap-16px ank-position-md-sticky ank-top-md-96px",
        "components": ["detailIntro", "detailAsideTitle", "detailAsideList"]
      }
    },
    {
      "id": "detailIntro",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.intro",
      "config": { "tag": "p", "text": "", "classes": "ank-m-0 ank-lineHeight-1_72 ank-color-secondaryTitleColor" }
    },
    {
      "id": "detailAsideTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.asideTitle",
      "config": { "tag": "h2", "text": "", "classes": "ank-m-0 ank-color-titleColor ank-fontSize-1_05rem ank-fontWeight-900" }
    },
    {
      "id": "detailAsideList",
      "type": "container",
      "loopConfig": {
        "source": "i18n",
        "path": "page.asideItems",
        "templateId": "detailAsideItemTemplate",
        "idPrefix": "detailAsideItem",
        "bindings": [{ "to": "config.text", "sources": ["$item"] }]
      },
      "config": { "tag": "div", "classes": "ank-display-flex ank-flexDirection-column ank-gap-8px", "components": [] }
    },
    {
      "id": "detailAsideItemTemplate",
      "type": "text",
      "config": { "tag": "p", "text": "", "classes": "mutedPanel ank-m-0 ank-fontWeight-800 ank-lineHeight-1_4" }
    },
    {
      "id": "detailCardsGrid",
      "type": "container",
      "loopConfig": {
        "source": "i18n",
        "path": "page.cards",
        "templateId": "detailCardTemplate",
        "idPrefix": "detailCard",
        "bindings": [
          { "to": "config.icon", "sources": ["icon"] },
          { "to": "config.title", "sources": ["title"] },
          { "to": "config.description", "sources": ["description"] },
          { "to": "config.benefits", "sources": ["benefits"] }
        ]
      },
      "config": { "tag": "div", "classes": "ank-display-grid ank-gridTemplateColumns-1fr ank-gap-16px", "components": [] }
    },
    {
      "id": "detailCardTemplate",
      "type": "generic-card",
      "config": {
        "variant": "feature",
        "icon": "",
        "title": "",
        "description": "",
        "benefits": [],
        "href": "",
        "linkLabel": "",
        "target": "_self",
        "rel": "",
        "classes": "panel ank-display-flex ank-flexDirection-column ank-gap-12px",
        "featureIconContainerClasses": "ank-display-flex",
        "featureIconClasses": "ank-fontSize-1_45rem ank-width-1_45rem ank-height-1_45rem ank-color-linkColor",
        "featureTitleClasses": "cardTitle",
        "featureDescriptionClasses": "cardDescription",
        "benefitsListClasses": "benefitList",
        "benefitItemClasses": "benefitItem",
        "benefitIconClasses": "ank-fontSize-1rem ank-color-accentColor ank-marginTop-2px",
        "benefitTextClasses": "ank-color-secondaryTitleColor",
        "linkClasses": "cardLink"
      }
    },
    {
      "id": "detailCta",
      "type": "container",
      "config": { "tag": "section", "classes": "sectionBase", "components": ["detailCtaPanel"] }
    },
    {
      "id": "detailCtaPanel",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "sectionContent panel",
        "components": ["detailCtaTitle", "detailCtaDescription", "detailCtaActions"]
      }
    },
    {
      "id": "detailCtaTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.ctaTitle",
      "config": { "tag": "h2", "text": "", "classes": "sectionTitle" }
    },
    {
      "id": "detailCtaDescription",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.ctaDescription",
      "config": { "tag": "p", "text": "", "classes": "sectionSubtitle" }
    },
    {
      "id": "detailCtaActions",
      "type": "container",
      "config": { "tag": "div", "classes": "ank-display-flex ank-gap-12px ank-flexWrap-wrap", "components": ["detailCtaPrimary", "detailCtaSecondary"] }
    },
    {
      "id": "detailCtaPrimary",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,page.primaryLabel;set:config.href,var,ctaTargets.calendlyUrl",
      "config": { "href": "#", "text": "", "target": "_blank", "rel": "noopener noreferrer", "classes": "primaryAction ank-color-bgColor" }
    },
    {
      "id": "detailCtaSecondary",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,page.secondaryLabel",
      "config": { "href": "/contacto", "text": "", "classes": "secondaryAction" }
    }
  ]
}

      "eventInstructions": "setScopeValue:city,TULUM;setScopeValue:rateMin,0.03;setScopeValue:rateMax,0.05",
      "valueInstructions": "set:config.label,i18n,page.calculator.cities.tulum;set:config.ariaSelected,when,\"all:scopeEq,values.city,TULUM\",true,false;set:config.classes,when,\"all:scopeEq,values.city,TULUM\",\"primaryAction ank-color-bgColor\",\"secondaryAction\"",

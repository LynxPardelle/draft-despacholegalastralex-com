        "classes": "sectionBase ank-bg-secondaryBgColor ank-paddingBlock-36px ank-paddingBlock-md-64px",
        "components": [
          "calculatorScope"
        ]
      }
    },
    {
      "id": "calculatorScope",
      "type": "interaction-scope",
      "config": {
        "scopeId": "isaiCalculator",
        "id": "isai-calculator",
        "tag": "section",
        "classes": "sectionContent panel ank-display-flex ank-flexDirection-column ank-gap-18px",
        "initialValues": {
          "city": "CDMX",
          "rateMin": 0.08,
          "rateMax": 0.09,
          "purchaseYear": ""
        },
        "computations": [
          {
            "resultId": "recoveryMin",
            "initial": {
              "source": "field",
              "fieldId": "propertyValue"
            },
            "steps": [
              {
                "op": "multiply",
                "value": {
                  "source": "field",
                  "fieldId": "rateMin"
                }
              },
              {
                "op": "round",
                "precision": 0
              }
            ]
          },
          {
            "resultId": "recoveryMax",
            "initial": {
              "source": "field",
              "fieldId": "propertyValue"
            },
            "steps": [
              {
                "op": "multiply",
                "value": {
                  "source": "field",
                  "fieldId": "rateMax"
                }
              },
              {
                "op": "round",
                "precision": 0
              }
            ]
          }
        ],
        "components": [
          "calculatorHeader",
          "calculatorCityLabel",
          "calculatorCityActions",
          "calculatorFields",
          "calculatorTimingNote",
          "calculatorResult"
        ]
      }
    },

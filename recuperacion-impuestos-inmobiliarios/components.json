      "valueInstructions": "set:config.label,i18n,page.calculator.cities.cdmx;set:config.ariaSelected,when,\"all:scopeEq,values.city,CDMX\",true,false;set:config.classes,when,\"all:scopeEq,values.city,CDMX\",\"primaryAction ank-color-bgColor\",\"secondaryAction\"",
      "config": {

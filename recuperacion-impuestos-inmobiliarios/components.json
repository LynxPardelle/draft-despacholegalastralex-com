        "label": "",
        "ariaSelected": false,
        "classes": "secondaryAction"
      }
    },
    {
      "id": "calculatorCityLosCabos",
      "type": "button",
      "eventInstructions": "setScopeValue:city,LOS_CABOS;setScopeValue:rateMin,0.03;setScopeValue:rateMax,0.05",
      "valueInstructions": "set:config.label,i18n,page.calculator.cities.losCabos;set:config.ariaSelected,when,\"all:scopeEq,values.city,LOS_CABOS\",true,false;set:config.classes,when,\"all:scopeEq,values.city,LOS_CABOS\",\"primaryAction ank-color-bgColor\",\"secondaryAction\"",
